// Prisma Schema pour Reputation OS
// Base de données: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modèle Utilisateur
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  plan               String    @default("free")
  
  // Tokens Google OAuth
  googleAccessToken  String?   @db.Text
  googleRefreshToken String?   @db.Text
  googleTokenExpiry  DateTime?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  businesses         Business[]
}

// Modèle Business (Entreprise/Établissement)
model Business {
  id            String   @id @default(cuid())
  name          String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // --- 1. Identité & SEO (Nouveau) ---
  type          String?  @default("Commerce local") // Ex: "Boulangerie"
  city          String?  // Ex: "Lyon"
  seoKeywords   String?  // Ex: "pain bio, sandwich pas cher"
  
  // --- 2. Infos Google (Classique) ---
  googlePlaceId String?  @unique
  address       String?  @db.Text
  description   String?  @db.Text
  website       String?
  phone         String?

  // 👇 --- AJOUTS POUR STRIPE --- 👇
  stripeCustomerId       String?   @unique // L'ID du client chez Stripe
  stripeSubscriptionId   String?   @unique // L'ID de l'abonnement
  stripePriceId          String?           // Quel plan il a choisi
  stripeCurrentPeriodEnd DateTime?         // Date d'expiration (pour savoir quand couper)
  
  // --- 3. Configuration IA (Cerveau) ---
  tone          String   @default("professional") // "professional", "friendly", "empathetic"
  signature     String?  // Ex: "L'équipe du Fournil"
  
  // --- 4. Relations ---
  reviews        Review[]
  customers      Customer[]
  reviewRequests ReviewRequest[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Modèle Review (Avis Google)
model Review {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  // Données de l'avis
  googleReviewId String?   @unique
  content        String    @db.Text
  rating         Int       
  authorName     String
  authorPhoto    String?
  reviewDate     DateTime  @default(now())
  
  // Réponse générée
  response       String?   @db.Text
  isReplied      Boolean   @default(false)
  repliedAt      DateTime?
  
  // Analyse IA
  sentiment      String?   
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  @@index([businessId])
}

// --- GESTION DES CLIENTS & CAMPAGNES ---

model Customer {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  
  name        String
  phone       String?  
  email       String?  
  source      String   @default("MANUAL") 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ReviewRequests ReviewRequest[] 

  @@index([businessId])
}

model ReviewRequest {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])

  channel     RequestChannel 
  status      RequestStatus  @default(SENT)
  cost        Float          @default(0.0) 

  sentAt      DateTime @default(now())
  clickedAt   DateTime? 
}

enum RequestChannel {
  SMS
  EMAIL
  QR_LIVE
}

enum RequestStatus {
  SENT
  DELIVERED
  FAILED
  CLICKED
}