// Prisma Schema pour Reputation OS
// Base de données: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modèle Utilisateur
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  plan               String    @default("free")
  
  // Tokens Google OAuth
  googleAccessToken  String?   @db.Text
  googleRefreshToken String?   @db.Text
  googleTokenExpiry  DateTime?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  businesses         Business[]
}

// Modèle Business (Entreprise/Établissement)
model Business {
  id             String    @id @default(cuid())
  name           String
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // --- 1. Identité & SEO ---
  type           String?   @default("Commerce local") 
  city           String?   
  seoKeywords    String?   
  
  // --- 2. Infos Google ---
  googlePlaceId  String?   @unique
  address        String?   @db.Text
  description    String?   @db.Text
  website        String?
  phone          String?

  googleUrl      String?   
  trustpilotUrl  String?
  focusAreas     String?   

  // --- 3. Configuration Stripe (Abonnement) ---
  stripeCustomerId       String?   @unique 
  stripeSubscriptionId   String?   @unique 
  stripePriceId          String?            
  stripeCurrentPeriodEnd DateTime?         
  
  // --- 4. Compteur IA (Le Vigile) ---
  aiUsageCount       Int       @default(0)       
  aiUsageLimitDate   DateTime  @default(now())    

  // --- 5. Configuration IA (Cerveau) ---
  tone            String    @default("professional") 
  signature       String? 
  
  // --- 6. Relations ---
  reviews         Review[]
  customers       Customer[]
  reviewRequests  ReviewRequest[]

  // --- 7. CONNEXIONS RÉSEAUX SOCIAUX (Tokens) ---
  facebookAccessToken   String? @db.Text
  facebookPageId        String?
  
  instagramAccessToken  String? @db.Text
  instagramAccountId    String?

  linkedinAccessToken   String? @db.Text
  linkedinUrn           String? // L'identifiant unique de la personne/page LinkedIn
  
  // Relation vers SocialPost
  SocialPost      SocialPost[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Modèle Review (Avis Google)
model Review {
  // Champs pour l'unicité (utilisés par le scraper)
  id              String    @id @default(cuid())
  
  // Champs utilisés par votre script d'import
  source          String    @default("google") 
  externalId      String    @default("")      
  
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  // Relation vers les posts réseaux sociaux
  SocialPost      SocialPost[]

  // Données de l'avis
  content         String    @db.Text
  rating          Int       
  authorName      String
  authorPhoto     String?
  reviewDate      DateTime  @default(now())
  
  // Réponse générée
  response        String?   @db.Text
  isReplied       Boolean   @default(false)
  repliedAt       DateTime?
  
  // Analyse IA
  sentiment       String?   
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([businessId])
  // Contrainte d'unicité composite pour éviter les doublons d'avis
  @@unique([source, externalId])
}

// --- GESTION DES CLIENTS & CAMPAGNES ---

model Customer {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  
  name            String
  phone           String?  
  email           String?  
  source          String    @default("MANUAL") 

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  ReviewRequests  ReviewRequest[] 

  @@index([businessId])
}

model ReviewRequest {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id])
  
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])

  channel         RequestChannel 
  status          RequestStatus  @default(SENT)
  cost            Float          @default(0.0) 

  sentAt          DateTime @default(now())
  clickedAt       DateTime? 
}

enum RequestChannel {
  SMS
  EMAIL
  QR_LIVE
}

enum RequestStatus {
  SENT
  DELIVERED
  FAILED
  CLICKED
}

// Modèle SocialPost (Marketing Studio)
model SocialPost {
  id           String   @id @default(cuid())
  externalPostId String? // ID renvoyé par Facebook/LinkedIn après publication

  // Relation Business
  businessId   String
  business     Business @relation(fields: [businessId], references: [id])
  
  // Relation vers Review
  reviewId     String?
  review       Review?  @relation(fields: [reviewId], references: [id])
  
  // Contenu du post
  caption      String   @db.Text 
  platform     String   @default("INSTAGRAM") 
  imageUrl     String?  
  
  // Gestion
  status       String   @default("DRAFT") 
  scheduledFor DateTime? 
  publishedAt  DateTime? // ✅ Date réelle de publication
  
  // ✅ NOUVEAU : STATISTIQUES (Pour la V2)
  statsLikes       Int       @default(0)
  statsViews       Int       @default(0)
  statsClicks      Int       @default(0)
  statsLastUpdated DateTime? // Pour savoir quand on a mis à jour les stats

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}