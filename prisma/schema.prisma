// Prisma Schema pour Reputation OS
// Base de données: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modèle Utilisateur
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  plan                  String    @default("free")
  
  // Tokens Google OAuth
  googleAccessToken     String?   @db.Text
  googleRefreshToken    String?   @db.Text
  googleTokenExpiry     DateTime?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  businesses            Business[]
}

// Modèle Business (Entreprise/Établissement)
model Business {
  id              String    @id @default(cuid())
  name            String
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Infos Business
  address         String?   @db.Text
  googlePlaceId   String?   @unique
  description     String?   @db.Text    // La description officielle sur Google
  category        String?               // Ex: "Restaurant Italien"
  website         String?
  phone           String?
  
  // Configuration IA
  tone            String?   @default("professionnel") // professionnel, amical, luxe
  policies        Json?     // Politiques (remboursement, etc.)
  signature       String?   @default("L'équipe")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // RELATIONS (C'est ici que j'ai ajouté les champs manquants)
  reviews         Review[]
  aiConfig        AIConfig?
  customers       Customer[]       // ✅ Relation vers les clients ajoutée
  reviewRequests  ReviewRequest[]  // ✅ Relation vers les demandes ajoutée
}

// Modèle Review (Avis Google)
model Review {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  // Données de l'avis
  googleReviewId  String?   @unique
  content         String    @db.Text
  rating          Int       // 1-5 étoiles
  authorName      String
  authorPhoto     String?
  reviewDate      DateTime  @default(now())
  
  // Réponse générée
  response        String?   @db.Text
  isReplied       Boolean   @default(false)
  repliedAt       DateTime?
  
  // Analyse IA
  sentiment       String?   // positif, neutre, negatif
  topics          Json?     // Liste des sujets identifiés
  actionRequired  Boolean   @default(false)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([businessId])
  @@index([sentiment])
  @@index([isReplied])
}

// Configuration des réponses IA
model AIConfig {
  id                   String    @id @default(cuid())
  businessId           String    @unique
  business             Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  // Paramètres de ton
  tone                 String    @default("professionnel")
  style                String    @default("standard")
  
  // Templates par type d'avis
  positiveTemplate     String?   @db.Text
  neutralTemplate      String?   @db.Text
  negativeTemplate     String?   @db.Text
  
  // Paramètres OpenAI
  temperature          Float     @default(0.7)
  maxTokens            Int       @default(150)
  
  // Options
  autoReply            Boolean   @default(false)
  includeBusinessName  Boolean   @default(true)
  addSignature         Boolean   @default(false)
  signature            String?
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// --- GESTION DES CLIENTS & CAMPAGNES ---

model Customer {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  
  name        String
  phone       String?  // Crucial pour le SMS
  email       String?  // Optionnel pour l'instant
  source      String   @default("MANUAL") // "MANUAL", "CSV", "QR_SCAN"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ReviewRequests ReviewRequest[] // Lien vers les demandes envoyées

  @@index([businessId])
}

model ReviewRequest {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])

  channel     RequestChannel // SMS, EMAIL, QR
  status      RequestStatus  @default(SENT)
  cost        Float          @default(0.0) // On stocke le coût réel pour ta compta (ex: 0.07€)

  sentAt      DateTime @default(now())
  clickedAt   DateTime? // Pour savoir si le lien magique a fonctionné
}

enum RequestChannel {
  SMS
  EMAIL
  QR_LIVE
}

enum RequestStatus {
  SENT
  DELIVERED
  FAILED
  CLICKED
}